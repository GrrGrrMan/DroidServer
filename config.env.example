# ==============================================================================
# DroidServer Global Configuration Contract
# Copy this file to 'config.env' and customize for your local setup.
# ==============================================================================

# Workstation Target Endpoint (Wireless ADB & SSH)
DEVICE_IP="192.168.1.35"
ADB_PORT="5555"
SSH_PORT="22"

# Remote Userland Identities
SERVER_USER="oppo"
SERVER_HOSTNAME="oppo"
CHROOT_DIR="/data/local/debian"

# Documentation Portal Port (Consolidated Single-Port)
DOCS_PORT="8080"